# n8n webhook that creates the Frappe Lead (server-side only, never exposed to the browser).
# Leave empty to skip the lead POST: the form still opens WhatsApp.
N8N_WEBHOOK_URL=https://workflows.automaticamente.co/webhook/pet-portrait

# Public site URL, used for canonical/OG tags and schema @id values
NEXT_PUBLIC_SITE_URL=https://crokoartista.co

# Optional Google Tag Manager container for the new brand (leave empty to disable)
NEXT_PUBLIC_GTM_ID=
